<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#011768" />
        </shape>
    </item>

    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#EFF0F8" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp" android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:startColor="@color/gradient_end"
                android:endColor="#08258E"
                android:angle="245"/>
        </shape>
    </item>
</layer-list>
